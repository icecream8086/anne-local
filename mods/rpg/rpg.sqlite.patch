 // allowBlock=false 用在游戏过程中的按需重连：共享连接未就绪时不在主线程阻塞。
+bool DetectSqliteDriver()
+{
+	char path[PLATFORM_MAX_PATH];
+	BuildPath(Path_SM, path, sizeof(path), "configs/databases.cfg");
+	KeyValues kv = new KeyValues("Databases");
+	if (!kv.ImportFromFile(path))
+	{
+		delete kv;
+		return false;
+	}
+	char def[32];
+	kv.GetString("driver_default", def, sizeof(def), "mysql");
+	bool sqlite = false;
+	if (kv.JumpToKey(DB_CONF_NAME))
+	{
+		char driver[32];
+		kv.GetString("driver", driver, sizeof(driver), "default");
+		if (StrEqual(driver, "default", false))
+		{
+			strcopy(driver, sizeof(driver), def);
+		}
+		sqlite = StrEqual(driver, "sqlite", false);
+	}
+	delete kv;
+	return sqlite;
+}
